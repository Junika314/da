@charset "utf-8";

:root { --bg: #f0f8ff; --panel: #fffdfa; --accent-1: #1e90ff; --accent-2: #ff6347; --retro-border: 4px solid #000; --maxw: 820px; }

html, body { height: 100%; }

body { margin: 0px; font-family: VT323, monospace; background-image: repeating-linear-gradient(45deg, rgb(230, 242, 255) 0px, rgb(230, 242, 255) 6px, rgb(255, 255, 255) 6px, rgb(255, 255, 255) 12px); background-color: var(--bg); display: flex; align-items: center; justify-content: center; padding: 30px 10px; color: rgb(0, 0, 0); }

.wrapper { width: 100%; max-width: var(--maxw); background: var(--panel); border: var(--retro-border); box-shadow: rgba(0, 0, 0, 0.15) 6px 6px 0px; padding: 18px; }

header { display: flex; flex-direction: column; align-items: center; margin-bottom: 12px; }

header h1 { font-family: "Press Start 2P", cursive; font-size: 18px; margin: 0px; }

header p { font-size: 13px; margin: 4px 0px 0px; }

nav { margin: 12px 0px; border-top: 2px solid rgb(0, 0, 0); border-bottom: 2px solid rgb(0, 0, 0); padding: 8px 6px; background: linear-gradient(90deg, rgba(0, 144, 255, 0.03), rgba(255, 99, 71, 0.03)); }

nav a { font-family: VT323, monospace; font-size: 14px; text-decoration: underline; color: var(--accent-1); margin-right: 14px; }

nav a:hover { color: var(--accent-2); }

main { display: flex; gap: 18px; flex-wrap: wrap; }

.section { flex: 1 1 0%; min-width: 250px; padding: 8px; border: 2px solid rgb(0, 0, 0); background: rgb(255, 255, 255); margin-bottom: 12px; }

a { color: var(--accent-1); text-decoration: underline; }

a:hover { color: var(--accent-2); }

footer { margin-top: 12px; font-size: 12px; text-align: center; font-family: monospace; }

.marquee { overflow: hidden; white-space: nowrap; margin: 10px 0px; }

.marquee p { display: inline-block; padding-left: 100%; animation: 12s linear 0s infinite normal none running marq; }

@keyframes marq { 
  0% { transform: translateX(0px); }
  100% { transform: translateX(-100%); }
}
